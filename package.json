{
  "name": "take-notes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup:admin": "node scripts/setup-admin.mjs",
    "db:backup": "node scripts/backup.mjs",
    "test:qa": "node --import tsx --conditions=react-server --test tests/qa-*.test.ts",
    "test:smoke": "node tests/private-smoke.mjs",
    "test:docker": "node tests/docker-smoke.mjs",
    "postinstall": "prisma generate --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "node scripts/migrate.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --config prisma7.config.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.44",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "ai": "^7.0.99",
    "dotenv": "^17.4.2",
    "iron-session": "^9.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0"
}
