DATABASE_URL="file:./dev.db"

# pnpm setup:admin 会生成密码哈希与随机会话密钥，保留你的其他配置。
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""
APP_URL="http://localhost:3000"
AI_DAILY_LIMIT="50"

# 可选：问问笔记。将真实密钥放在 .env.local，不能加 NEXT_PUBLIC_ 前缀。
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"
# 默认直连 DeepSeek 官方接口；使用其他受信任服务时再调整。
DEEPSEEK_BASE_URL="https://api.deepseek.com"
